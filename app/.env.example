# 复制为 .env 并按需修改

# Windows 原生开发：本地 SQLite 文件路径
DATABASE_URL="file:D:/Project/.data/app.db"

# Auth.js（next-auth v5 beta）：请改成随机长字符串
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_TRUST_HOST=true

# ---- 火山方舟（M6 真实模型）----
# 在方舟控制台创建 API Key 后填入。留空则文本/图片/视频节点全部走 mock 实现。
# 注意：模型需先在控制台「开通」，否则会返回 ModelNotOpen。
ARK_API_KEY=""
# 需要覆盖默认模型时再填（一般不用，服务端有 UI 产品名 → 模型 id 的映射表）
# ARK_MODEL_TEXT="doubao-seed-2-1-pro-260628"
# ARK_MODEL_IMAGE="doubao-seedream-5-0-pro-260628"
# ARK_MODEL_VIDEO="doubao-seedance-1-0-pro-fast-251015"
# 单次运行超时（毫秒），默认 5 分钟。视频任务较慢，可按需调大。
# RUN_TIMEOUT_MS=300000
